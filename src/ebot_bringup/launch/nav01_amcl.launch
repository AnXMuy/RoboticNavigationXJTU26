<?xml version="1.0"?>
<launch>
  <arg name="mode" default="real"/>
  <arg name="amcl_profile" default="baseline" doc="baseline|fast|robust"/>

  <arg name="real_baseline" default="$(find ebot_bringup)/config/localization/amcl_real.yaml"/>
  <arg name="real_fast" default="$(find ebot_bringup)/config/localization/amcl_real_fast.yaml"/>
  <arg name="real_robust" default="$(find ebot_bringup)/config/localization/amcl_real_robust.yaml"/>

  <arg name="sim_baseline" default="$(find ebot_bringup)/config/localization/amcl_sim.yaml"/>
  <arg name="sim_fast" default="$(find ebot_bringup)/config/localization/amcl_sim_fast.yaml"/>
  <arg name="sim_robust" default="$(find ebot_bringup)/config/localization/amcl_sim_robust.yaml"/>

  <arg name="profile_file"
       default="$(eval (sim_fast if amcl_profile == 'fast' else (sim_robust if amcl_profile == 'robust' else sim_baseline)) if mode == 'sim' else (real_fast if amcl_profile == 'fast' else (real_robust if amcl_profile == 'robust' else real_baseline)))"/>

  <!-- allow explicit file override -->
  <arg name="config_file" default="$(arg profile_file)"/>

  <node pkg="amcl"
        type="amcl"
        name="amcl"
        output="screen">
    <rosparam command="load" file="$(arg config_file)"/>
  </node>
</launch>
