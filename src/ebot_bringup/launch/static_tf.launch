<?xml version="1.0"?>
<launch>
  <arg name="base_footprint_frame" default="base_footprint"/>
  <arg name="base_link_frame" default="base_link"/>
  <arg name="laser_frame" default="laser_link"/>

  <arg name="laser_x" default="0.0"/>
  <arg name="laser_y" default="0.0"/>
  <arg name="laser_z" default="0.15"/>
  <arg name="laser_yaw" default="3.1415"/>
  <arg name="laser_pitch" default="0.0"/>
  <arg name="laser_roll" default="0.0"/>

  <!-- Publish the body frame used by navigation -->
  <node pkg="tf2_ros"
        type="static_transform_publisher"
        name="base_footprint_to_base_link"
        args="0 0 0 0 0 0 $(arg base_footprint_frame) $(arg base_link_frame)" />

  <!-- Publish the lidar mounting pose -->
  <node pkg="tf2_ros"
        type="static_transform_publisher"
        name="base_link_to_laser_link"
        args="$(arg laser_x) $(arg laser_y) $(arg laser_z) $(arg laser_yaw) $(arg laser_pitch) $(arg laser_roll) $(arg base_link_frame) $(arg laser_frame)" />
</launch>
