<?xml version="1.0"?>
<launch>
  <arg name="base_footprint_frame" default="base_footprint"/>
  <arg name="base_link_frame" default="base_link"/>

  <!-- Keep TF tree complete for mapping/localization/navigation. -->
  <node pkg="tf2_ros"
        type="static_transform_publisher"
        name="base_footprint_to_base_link"
        args="0 0 0 0 0 0 $(arg base_footprint_frame) $(arg base_link_frame)" />
</launch>
