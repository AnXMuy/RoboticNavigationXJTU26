<?xml version="1.0"?>
<launch>
    <!-- 加载机器人模型 -->
    <param name="robot_description" textfile ="$(find ebot_description)/urdf/mini_akm_robot.urdf"/>
    
    <!-- 启动机器人状态和关节状态发布节点 -->
    <node name="ebot_joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" />
    <node name="ebot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />
    
    <!-- 启动图形化的控制关节运动节点 -->
    <node name="ebot_joint_state_publisher_gui" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui" />
    
    <!-- 运行rviz可视化界面 -->
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find ebot_description)/rviz/ebot_urdf.rviz" required="true" />
    
</launch>
