<launch>
  <node pkg="tf2_ros"
        type="static_transform_publisher"
        name="base_footprint2base_link"
        args="0 0 0 0 0 0 base_footprint base_link"/>

  <node pkg="tf2_ros"
        type="static_transform_publisher"
        name="base_link2laser_link"
        args="0.0 0.0 0.15 3.1415 0.0 0.0 base_link laser_link"/>
</launch>
