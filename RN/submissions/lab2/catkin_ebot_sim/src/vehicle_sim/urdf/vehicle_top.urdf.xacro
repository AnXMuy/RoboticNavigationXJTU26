<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="vehicle_sim">
  <material name="blue"><color rgba="0.0 0.1 0.8 1.0"/></material>
  <material name="black"><color rgba="0.02 0.02 0.02 1.0"/></material>
  <material name="gray"><color rgba="0.45 0.45 0.45 1.0"/></material>

  <link name="base_footprint" />

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.42 0.30 0.12"/></geometry>
      <material name="blue"/>
    </visual>
  </link>

  <xacro:macro name="wheel" params="name x y">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.055" length="0.045"/></geometry>
        <material name="black"/>
      </visual>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} -0.04" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="front_left_wheel" x="0.15" y="0.18"/>
  <xacro:wheel name="front_right_wheel" x="0.15" y="-0.18"/>
  <xacro:wheel name="rear_left_wheel" x="-0.15" y="0.18"/>
  <xacro:wheel name="rear_right_wheel" x="-0.15" y="-0.18"/>

  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.04"/></geometry>
      <material name="gray"/>
    </visual>
  </link>
  <joint name="base_link_to_laser" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.10 0 0.10" rpy="0 0 0"/>
  </joint>
</robot>
