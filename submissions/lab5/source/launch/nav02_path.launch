<?xml version="1.0"?>
<launch>
  <node pkg="move_base"
        type="move_base"
        name="move_base"
        output="screen"
        clear_params="true"
        respawn="false">
    <rosparam file="$(find ebot_bringup)/param/costmap_common_params.yaml"
              command="load" ns="global_costmap"/>
    <rosparam file="$(find ebot_bringup)/param/costmap_common_params.yaml"
              command="load" ns="local_costmap"/>
    <rosparam file="$(find ebot_bringup)/param/local_costmap_params.yaml"
              command="load"/>
    <rosparam file="$(find ebot_bringup)/param/global_costmap_params.yaml"
              command="load"/>
    <rosparam file="$(find ebot_bringup)/param/base_local_planner_params.yaml"
              command="load"/>
    <rosparam file="$(find ebot_bringup)/param/move_base_params.yaml"
              command="load"/>
  </node>
</launch>
